# ===========================================================================
#  LinkedIn Job Agent — configuration template
#
#    cp .env.example .env
#
#  Generate the API key:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
#  Every value is validated at startup. A bad combination stops the container
#  with a named error instead of misbehaving later.
# ===========================================================================

# ── Application ────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
TIMEZONE=UTC

# ── API ────────────────────────────────────────────────────────────────
# Shared secret for the X-API-Key header, at least 16 characters.
API_KEY=change-me-to-a-long-random-string

# Comma-separated. Leave empty unless you add a UI on another origin.
CORS_ORIGINS=

# Base URL used in notification links.
PUBLIC_URL=http://localhost:8088

# ── Database ───────────────────────────────────────────────────────────
POSTGRES_USER=linkedin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=linkedin_agent
# Host is the compose service name. Must use the asyncpg driver, and the
# password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://linkedin:change-me@postgres:5432/linkedin_agent
DB_POOL_SIZE=5
DB_ECHO=false

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json in production; `console` is easier to read locally.
LOG_FORMAT=json
LOG_DIR=/data/logs

# ── Storage paths (inside the container) ───────────────────────────────
DATA_DIR=/data
RESUME_DIR=/data/resumes
PROFILE_PATH=/data/profile/answers.yaml

# ===========================================================================
#  AI PROVIDER
# ===========================================================================
# openai_compatible : any /v1/chat/completions endpoint
# ollama            : a local Ollama daemon, fully offline
# rules             : NO language model. Keyword scoring only; refuses to write
#                     cover letters or answer questions. Free and private.
AI_PROVIDER=openai_compatible

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-provider-api-key
AI_MODEL=gpt-4o-mini

# Other providers speaking the same schema — swap BASE_URL + MODEL:
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama      AI_PROVIDER=ollama  AI_BASE_URL=http://ollama:11434  AI_MODEL=llama3.1:8b

AI_TEMPERATURE=0.2

# For reasoning models this budget covers THINKING tokens as well as the
# visible answer. Too small a value returns an empty response with no error.
AI_MAX_TOKENS=1500

AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3

# ===========================================================================
#  REVIEW POLICY
# ===========================================================================
# Below this score a job is skipped.
MIN_SCORE_TO_APPLY=70

# With REVIEW_MODE=threshold, a clean match at or above this goes straight to
# your "approved" shortlist. Must be >= MIN_SCORE_TO_APPLY.
AUTO_APPLY_SCORE_THRESHOLD=85

# always    : everything waits for you. The default.
# threshold : clean matches at/above the threshold are shortlisted for you.
# never     : clean matches are shortlisted without asking.
#
# Three things force review whatever this says: a cover letter that failed
# the fact check, a question that could not be answered from known facts, and
# a score computed without a language model. Either way, nothing is ever
# submitted for you.
REVIEW_MODE=always

GENERATE_COVER_LETTERS=true

# ===========================================================================
#  NOTIFICATIONS (optional) — told when jobs are waiting for review
# ===========================================================================
# Routes ONLY notification traffic, e.g. socks5://127.0.0.1:1080
NOTIFY_PROXY_URL=

# --- Telegram (@BotFather for the token, @userinfobot for your chat id) ---
NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (Server Settings > Integrations > Webhooks) ---
NOTIFY_DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# --- Slack (Incoming Webhooks app) ---
NOTIFY_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# --- Email (Gmail needs an App Password, not your account password) ---
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
