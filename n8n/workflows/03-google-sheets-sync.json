        2608
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  title: 'Google Sheets sync failed',\n  body: [\n    'The application export could not be written to the sheet.',\n    '',\n    'Usual causes:',\n    '  - the Google credential expired or was revoked',\n    '  - the sheet ID is wrong, or the sheet was renamed/deleted',\n    '  - the tab is not called \"Applications\"',\n    '',\n    'Nothing else is affected - this workflow only reads and reports.',\n  ].join('\\n'),\n} }];"
      },
      "id": "58a7ca92-b500-4b25-bf31-383872ad524c",
      "name": "Sync failed",
      "type": "n8n-nodes-base.code",
