    {
      "parameters": {
        "jsCode": "// The API already returns flat rows, so there is nothing to join here.\n// This only renames fields to human column headers and adds two derived\n// columns that are genuinely useful when scanning a sheet on a phone.\nconst LABEL = {\n  pending_review: 'WAITING FOR YOU',\n  approved:       'SHORTLISTED - apply yourself',\n  submitted:      'applied',\n  skipped:        'skipped',\n  needs_manual:   'NEEDS YOUR INPUT',\n};\n\nreturn $input.all().map(({ json: r }) => ({\n  json: {\n    'ID':          r.application_id,\n    'Status':      LABEL[r.status] ?? r.status,\n    'Score':       r.score ?? '',\n    'Job Title':   r.title,\n    'Company':     r.company,\n    'Location':    r.location,\n    'Resume Used': r.resume,\n    // Surfaced as its own column: an unsupported claim is the one thing\n    // worth spotting at a glance before approving anything.\n    'Honesty Flag': r.cover_letter_flagged ? 'REVIEW LETTER' : '',\n    'Why Waiting': r.review_reason || r.skip_reason || '',\n    'Discovered':  r.discovered,\n    'Submitted':   r.submitted,\n    'Link':        r.url,\n  },\n}));"
      },
      "id": "254196ef-9bc1-495d-9ec4-6a01a7a56f45",
      "name": "Shape for the sheet",
